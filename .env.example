OPENAI_API_KEY=sk-your-key-here

# Optional. If set, Shortcuts and Toodles must send Authorization: Bearer this-value
# or X-App-Secret: this-value.
APP_SHARED_SECRET=

# Optional. If set, /admin and /api/admin/usage require this separate secret.
ADMIN_SECRET=

# Defaults are chosen for work order summaries.
OPENAI_MODEL=gpt-5.4-mini
OPENAI_REASONING_EFFORT=low
PORT=8787

# Usage tracking and app-side hard cap.
DAILY_SPEND_CAP_USD=1.00
USAGE_DB_PATH=./data/toodles-usage.sqlite
OPENAI_INPUT_COST_PER_1M_TOKENS=1.25
OPENAI_OUTPUT_COST_PER_1M_TOKENS=10.00
USAGE_UNKNOWN_REQUEST_COST_USD=0.05

# Field caps are character counts before the request is sent to OpenAI.
MAX_SOURCE_CHARS=12000
MAX_FIELD_NOTES_CHARS=12000
MAX_OCR_CHARS=12000
MAX_LABOR_CHARS=5000
MAX_FOLLOW_UP_CHARS=5000
